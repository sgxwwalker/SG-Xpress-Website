# The one superadmin account for /admin (manages staff, sees the activity log).
# Its password is stored as a base64-encoded bcrypt hash. Generate it with:
#   npm run hash-password   (asks for the password without showing it)
SUPERADMIN_USERNAME=admin
SUPERADMIN_NAME=Superadmin
ADMIN_PASSWORD_HASH_B64=

# Signs the admin login cookie. Generate with:  openssl rand -base64 32
SESSION_SECRET=

# Where staff edits are saved. staff.json, activity.json and messages.json are kept in the same folder. Keep this OUTSIDE the app folder on the server
# so redeploys never overwrite it. Defaults to ./data/content.json.
CONTENT_FILE=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable tracking.
NEXT_PUBLIC_GA_ID=

# Public address of the site, used for the sitemap and social previews.
# Set to "staging" on the staging copy only: hides it from search engines.
NEXT_PUBLIC_SITE_ENV=
NEXT_PUBLIC_SITE_URL=https://sgxpressja.com

# Contact form. Messages are always saved and shown in /admin → Messages.
# To also email them, fill in your mail provider's SMTP details:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=info@sgxpressja.com
# Optional: where job applications are emailed (defaults to CONTACT_TO).
CAREERS_TO=hr@sgxpressja.com
# Optional: where messages are saved. Defaults to messages.json next to CONTENT_FILE.
MESSAGES_FILE=

# Optional Cloudflare Turnstile spam check on the contact form (free at dash.cloudflare.com).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
